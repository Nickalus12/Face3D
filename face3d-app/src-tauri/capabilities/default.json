{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Face3D app capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:read-all",
    "fs:allow-exists",
    "fs:allow-stat",
    "dialog:allow-open",
    "dialog:allow-save",
    "libsql:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "D:/Projects/3D/**" }
      ]
    }
  ]
}
